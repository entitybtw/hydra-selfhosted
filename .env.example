# Required: random secret string used to sign sessions and for the launcher
API_TOKEN=change-me-to-random-string

# Host port the server is exposed on (container always listens on 3000)
PORT=3000

# Image tag to run: latest or a pinned version (e.g. v0.0.1)
#TAG=v0.0.1

# Launcher session duration in days
SESSION_TTL_DAYS=30

# Public URL of this server (shown in the web dashboard)
PUBLIC_URL=http://localhost:3000

# Max cloud save upload size in MB
MAX_SAVE_SIZE_MB=50

# While the server has no admin, the account with this username becomes admin.
# It is not created for you: register it right after the first start, before anyone else can.
# Unset, the first registered user becomes admin.
#INITIAL_ADMIN_USERNAME=admin

# Bearer token for the admin API (/admin/*), which is off while unset
# If set, it must equal API_TOKEN (the launcher checks it too when saving its settings),
# so every launcher user gets admin API access
#INSTANCE_TOKEN=

# WebAuthn (passkeys) — required for production over HTTPS
# RP_ID is the bare domain, ORIGIN is the full URL
#WEBAUTHN_RP_ID=your-domain.com
#WEBAUTHN_ORIGIN=https://your-domain.com

# Single sign-on via OpenID Connect (e.g. authentik) — off unless OIDC_ISSUER and OIDC_CLIENT_ID are set
# Redirect URI to register at the provider: <PUBLIC_URL>/web/oidc/callback
#OIDC_ISSUER=https://auth.your-domain.com/application/o/hydra/
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=

# Comma-separated allowed CORS origins
#CORS_ORIGINS=https://your-domain.com
