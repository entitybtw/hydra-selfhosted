# Required: random secret string used to sign sessions and for the launcher
API_TOKEN=change-me-to-random-string

# Host port the server is exposed on (container always listens on 3000)
PORT=3000

# Image tag to run: latest or a pinned version (e.g. v0.0.1)
#TAG=v0.0.1

# Launcher session duration in days
SESSION_TTL_DAYS=30

# Public URL of this server (shown in the web dashboard)
PUBLIC_URL=http://localhost:3000

# Max cloud save upload size in MB
MAX_SAVE_SIZE_MB=50

# Username of the initial admin user (set once on first run)
#INITIAL_ADMIN_USERNAME=admin

# WebAuthn (passkeys) — required for production over HTTPS
# RP_ID is the bare domain, ORIGIN is the full URL
#WEBAUTHN_RP_ID=your-domain.com
#WEBAUTHN_ORIGIN=https://your-domain.com

# Comma-separated allowed CORS origins
#CORS_ORIGINS=https://your-domain.com
